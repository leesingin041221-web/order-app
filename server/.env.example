# ===========================================
# COZY API — 환경 변수 예시 (.env.example)
# copy .env.example .env 후 값 수정
# ===========================================

# --- 서버 ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# 로컬: http://localhost:5173
# Render Static Site (프론트):
# CORS_ORIGIN=https://order-app-frontend-yfr4.onrender.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL (권장: DATABASE_URL 한 줄만 사용) ---
#
# [로컬 PC → Render DB] External Database URL + sslmode
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# [로컬 PostgreSQL]
# DATABASE_URL=postgresql://postgres:비밀번호@localhost:5432/cozy
#
# [Render Web Service 환경 변수] Internal Database URL (External 아님)

DATABASE_URL=postgresql://postgres:비밀번호@localhost:5432/cozy
