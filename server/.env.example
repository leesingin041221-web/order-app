# ===========================================
# COZY API — 환경 변수 예시 (.env.example)
# 이 파일을 복사해 .env 로 만든 뒤 값을 수정하세요
# ===========================================

# --- 서버 ---
PORT=3000
NODE_ENV=development

# --- CORS (프런트엔드 주소) ---
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL (방법 1: 한 줄 연결, 권장) ---
DATABASE_URL=postgresql://postgres:여기에_비밀번호@localhost:5432/cozy

# --- PostgreSQL (방법 2: 항목별 설정) ---
# DATABASE_URL 을 비우면 아래 값 사용
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=여기에_비밀번호
PGDATABASE=cozy
